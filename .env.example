DATABASE_URL=jdbc:postgresql://localhost:15432/nexus
DATABASE_USERNAME=nexus
DATABASE_PASSWORD=nexus
PG_PREPARE_THRESHOLD=0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=nexus-local
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Supabase transaction pooler format for Spring Boot:
# DATABASE_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_USERNAME=postgres.project-ref
# DATABASE_PASSWORD=replace-with-rotated-password

# Upstash TLS Redis format for Spring Boot:
# REDIS_URL=rediss://default:replace-with-rotated-token@your-endpoint.upstash.io:6379
# Optional REST client values:
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-rotated-token

# Clerk authentication:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

# Razorpay test payments:
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=replace-with-test-secret
# RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Google SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=sender@example.com
# SMTP_PASSWORD=app-password-only
# SMTP_FROM_EMAIL=sender@example.com
# SMTP_FROM_NAME=Nexus

# Google Calendar OAuth:
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback

# LiveKit:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...

# Cloudflare R2:
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=...
# R2_SECRET_KEY=...
# R2_BUCKET=nexus-files

# Supabase Storage alternative (no Cloudflare R2 subscription):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
# SUPABASE_STORAGE_BUCKET=nexus-files
